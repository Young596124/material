<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.material.modules.material.mapper.MaterialOutboundMapper">

    <resultMap type="com.material.modules.material.domain.MaterialOutbound" id="MaterialOutboundResult">
        <id     property="id"            column="id"            />
        <result property="outboundCode"  column="outbound_code" />
        <result property="userId"        column="user_id"      />
        <result property="userName"       column="user_name"     />
        <result property="description"    column="description"   />
        <result property="createBy"       column="create_by"    />
        <result property="createTime"     column="create_time"  />
    </resultMap>

    <sql id="selectOutboundVo">
        select id, outbound_code, user_id, user_name, description, create_by, create_time
        from material_outbound
    </sql>

    <select id="selectOutboundList" resultMap="MaterialOutboundResult">
        <include refid="selectOutboundVo"/>
        <where>
            <if test="outbound.outboundCode != null and outbound.outboundCode != ''">
                AND outbound_code like concat('%', #{outbound.outboundCode}, '%')
            </if>
            <if test="outbound.userName != null and outbound.userName != ''">
                AND user_name like concat('%', #{outbound.userName}, '%')
            </if>
            <if test="outbound.beginDate != null and outbound.beginDate != ''">
                AND create_time &gt;= #{outbound.beginDate}
            </if>
            <if test="outbound.endDate != null and outbound.endDate != ''">
                AND create_time &lt;= #{outbound.endDate}
            </if>
        </where>
        order by id desc
    </select>

    <select id="selectOutboundExportList" resultMap="MaterialOutboundResult">
        <include refid="selectOutboundVo"/>
        <where>
            <if test="outbound.outboundCode != null and outbound.outboundCode != ''">
                AND outbound_code like concat('%', #{outbound.outboundCode}, '%')
            </if>
            <if test="outbound.userName != null and outbound.userName != ''">
                AND user_name like concat('%', #{outbound.userName}, '%')
            </if>
            <if test="outbound.beginDate != null and outbound.beginDate != ''">
                AND create_time &gt;= #{outbound.beginDate}
            </if>
            <if test="outbound.endDate != null and outbound.endDate != ''">
                AND create_time &lt;= #{outbound.endDate}
            </if>
        </where>
        order by id desc
    </select>
</mapper>
